# Kinetiq Environment Variables Template
PORT=8080
DATABASE_URL=postgres://kinetiq:kinetiq_secure_password@localhost:5432/kinetiq?sslmode=disable
REDIS_URL=redis://localhost:6379

# Auth Secrets (Generate using `openssl rand -hex 32`)
BETTER_AUTH_SECRET=changeme_better_auth_secret_kinetiq_min_32_chars
INTERNAL_AUTH_SECRET=changeme_internal_auth_secret_kinetiq_min_32_chars

# Public URLs
AUTH_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
PUBLIC_AUTH_URL=http://localhost:3001

# Ingestion & Workers
INGESTION_MAX_BATCH_SIZE=100
WORKER_BATCH_SIZE=500
WORKER_FLUSH_INTERVAL=1s
RATE_LIMIT_RPS=500
RATE_LIMIT_BURST=1000
